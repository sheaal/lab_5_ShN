<Window x:Class="lab_4_ShN.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_4_ShN"
        mc:Ignorable="d"
        Title="Морды Протокольные" Height="500" Width="800" WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush ImageSource="img/фон1.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#111184"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                            </Border>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="#4CAF50"
                                    CornerRadius="10">
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border Background="#66000000" Margin="10" CornerRadius="15">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,74,0,0">
                    <Image x:Name="EnemyImage" Width="200" Height="200"
                           MouseLeftButtonDown="EnemyImage_MouseLeftButtonDown" Cursor="Hand"/>

                    <TextBlock x:Name="EnemyNameText" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <TextBlock x:Name="EnemyHPText" FontSize="18"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>

                    <ProgressBar x:Name="CooldownBar" Width="200" Height="20" Margin="0,5,0,0"
                             Minimum="0" Maximum="1" Value="0"/>

                    <TextBlock x:Name="EnemyRewardText" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Золото:" FontSize="16"/>
                    <TextBlock x:Name="PlayerGoldText" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Урон:" FontSize="16"/>
                    <TextBlock x:Name="PlayerDamageText" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Стоимость улучшения:" FontSize="16"/>
                    <TextBlock x:Name="UpgradeCostText" FontSize="18" Margin="0,0,0,10"/>

                    <Button x:Name="UpgradeButton" Content="Улучшить урон"
                            Width="200" Height="35" Click="UpgradeButton_Click" Margin="0,0,0,10"/>

                    <Button x:Name="UpgradeCooldownButton" Content="Улучшить перезарядку"
                            Width="200" Height="35" Click="UpgradeCooldownButton_Click"/>

                    <Button x:Name="SaveGameButton" Content="Сохранить игру"
                            Width="200" Height="35" Click="SaveGameButton_Click" Margin="0,15,0,0"/>

                    <Button x:Name="LoadGameButton" Content="Загрузить игру"
                            Width="200" Height="35" Click="LoadGameButton_Click" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Canvas x:Name="SphereCanvas" IsHitTestVisible="False" Background="Transparent"/>
    </Grid>
</Window>